{
  "name": "rig",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "STAMP=\"$(git describe --always --dirty --abbrev=12 --exclude='*' 2>/dev/null || echo dev)\" && bun build --compile --define process.env.RIG_BUILD_COMMIT=\"\\\"$STAMP\\\"\" src/index.ts --outfile rig && bun build --compile --define process.env.RIG_BUILD_COMMIT=\"\\\"$STAMP\\\"\" src/rigd.ts --outfile rigd && bun build --compile --define process.env.RIG_BUILD_COMMIT=\"\\\"$STAMP\\\"\" src/git/remote-helper.ts --outfile git-remote-rig",
    "start": "bun run src/index.ts",
    "schema": "bun run scripts/generate-schema.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "bin": {
    "rig": "./rig",
    "rigd": "./rigd",
    "git-remote-rig": "./git-remote-rig"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "3.9.8",
    "shadcn": "^4.21.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "15.0.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  }
}
