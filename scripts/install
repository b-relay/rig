#!/bin/sh
# Installs Rig on this Mac: `rig` and `rigd` into the Rig root's bin directory (~/.rig/bin), then `rigd install`,
# which starts rigd as a LaunchAgent (with RIG_ROOT set, as a detached process instead).
#
# Read it before you run it. It downloads one release of https://github.com/b-relay/rig, checks the download
# against that release's SHA256SUMS, and writes nothing outside the Rig root; `rigd install` then sets rigd up.
# To check the files were built by Rig's own release workflow: gh attestation verify <file> --repo b-relay/rig
#
#   RIG_ROOT  where Rig keeps everything (default ~/.rig); must be an absolute path.
set -eu

# The release this copy installs: the release workflow writes its tag here.
version="__RIG_RELEASE__"
# Where releases are downloaded from; tests point it at local files.
releases="${RIG_RELEASE_URL:-https://github.com/b-relay/rig/releases/download}"

fail() {
	printf 'rig install: %s\n' "$1" >&2
	exit 1
}

case "$version" in
v*) ;;
*) fail "this copy of install belongs to no release. Download it from https://github.com/b-relay/rig/releases/latest/download/install" ;;
esac
[ "$(uname -s)" = Darwin ] || fail "Rig runs on macOS only."
case "$(uname -m)" in
arm64) arch=arm64 ;;
x86_64)
	# A shell under Rosetta reports x86_64 on Apple Silicon; the native build is the one to run.
	if [ "$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)" = 1 ]; then arch=arm64; else arch=x64; fi
	;;
*) fail "no Rig build for $(uname -m)." ;;
esac
root="${RIG_ROOT:-$HOME/.rig}"
case "$root" in
/*) ;;
*) fail "RIG_ROOT must be an absolute path, but it is \"$root\"." ;;
esac

# A Rig Project's Target that publishes rig or rigd owns that file; this installer never replaces one.
for name in rig rigd; do
	destination="$root/bin/$name"
	owner="$root/installed/owners/$(printf '%s' "$destination" | shasum -a 256 | cut -d ' ' -f 1).json"
	[ ! -e "$owner" ] || fail "$destination was published by a Rig Project's Target, which owns it, so install leaves it alone. Stop that Target publishing it, or install into another RIG_ROOT."
done

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
build="rig-$version-darwin-$arch"
printf 'Downloading Rig %s for %s...\n' "$version" "$arch"
curl -fsSL -o "$work/$build.tar.gz" "$releases/$version/$build.tar.gz" || fail "could not download $releases/$version/$build.tar.gz"
curl -fsSL -o "$work/SHA256SUMS" "$releases/$version/SHA256SUMS" || fail "could not download $releases/$version/SHA256SUMS"
grep "  $build.tar.gz\$" "$work/SHA256SUMS" >"$work/expected" || fail "SHA256SUMS lists no $build.tar.gz."
(cd "$work" && shasum -a 256 -c expected >/dev/null 2>&1) || fail "$build.tar.gz does not match the release's SHA256SUMS; nothing was installed."
mkdir "$work/unpacked"
tar -xzf "$work/$build.tar.gz" -C "$work/unpacked"

# Each executable is copied beside its destination and renamed over it, so a running rigd keeps the file it started
# from and nothing ever sees a half-written one.
mkdir -p "$root/bin"
for name in rig rigd; do
	[ -f "$work/unpacked/$build/$name" ] || fail "$build.tar.gz has no $name."
	cp "$work/unpacked/$build/$name" "$root/bin/.$name.installing"
	chmod 755 "$root/bin/.$name.installing"
	mv -f "$root/bin/.$name.installing" "$root/bin/$name"
done
printf 'Installed rig and rigd %s in %s/bin.\n' "$version" "$root"

"$root/bin/rigd" install

case ":$PATH:" in
*":$root/bin:"*) ;;
*) printf '\nAdd Rig to your PATH, for example in ~/.zshrc:\n  export PATH="%s/bin:$PATH"\n' "$root" ;;
esac
